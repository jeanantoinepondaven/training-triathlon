# Neon connection string (Vercel → Storage → Neon, or neon.tech → Connection string).
# Leave unset locally to use the embedded database in ./.pglite
DATABASE_URL=

# Random string used to sign login cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Who may create an account (comma-separated). Leave empty to allow the first MAX_USERS sign-ups.
ALLOWED_EMAILS=
MAX_USERS=2

# Time zone used to decide what "today" is.
APP_TIMEZONE=Europe/Paris
